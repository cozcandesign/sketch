# MarketPulse konfigürasyonu. Bu dosyayı `.env` olarak kopyalayın: cp .env.example .env
# Anahtar listesi ve açıklamalar: ARCHITECTURE.md §16. `.env` git'e girmez.

MP_ENV=dev
MP_LOG_LEVEL=INFO

# Veri
MP_DATA_DIR=./data
MP_DB_URL=sqlite+aiosqlite:///./data/marketpulse.db
MP_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
MP_TIMEZONE=Europe/Istanbul

# API
MP_API_HOST=0.0.0.0
MP_API_PORT=8000
MP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Haber / LLM (Faz 4'te kullanılır). ANTHROPIC_API_KEY boşsa haber modülü "veri yok" der, sistem çalışır.
ANTHROPIC_API_KEY=
MP_LLM_TIER1_MODEL=claude-haiku-4-5
MP_LLM_TIER2_MODEL=claude-sonnet-5
MP_LLM_TIER2_THRESHOLD=0.6
MP_LLM_DAILY_BUDGET_USD=3.0
MP_NEWS_INGEST_LATENCY_SEC=300
# Opsiyonel: CryptoPanic anahtarı yoksa o collector kapalı kalır.
CRYPTOPANIC_TOKEN=

# Binance public uç noktaları (API anahtarı YOK; yalnızca public veri)
MP_BINANCE_SPOT_BASE=https://api.binance.com
MP_BINANCE_FUTURES_BASE=https://fapi.binance.com
MP_BINANCE_WS_SPOT=wss://stream.binance.com:9443/stream
MP_BINANCE_WS_FUTURES=wss://fstream.binance.com/stream
